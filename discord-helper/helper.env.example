# Copy to helper.env on Wald (chmod 600). Never commit helper.env.
# This is NOT /data/windsage/oauth.env and NOT the website Discord OAuth app.
# No LLM keys. Wind commands call WINDSAGE_API_URL /v1.

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Snowflakes from Discord (channel names are not enough)
ASK_CHANNEL_ID=
MOD_CHANNEL_ID=
RULES_CHANNEL_ID=

# Comma-separated. Empty = that feature stays off (fail closed).
MOD_ROLE_IDS=
ALLOWED_CATEGORY_IDS=
COSMETIC_ROLE_IDS=

# Same brain as the PWA.
WINDSAGE_API_URL=https://windsage.nimrod.bio

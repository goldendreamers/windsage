# Copy to discord-updates.env (gitignored) or append to .env.smtp.
# Never commit the real webhook URL.
#
# Discord → #windsage-updates → Edit Channel → Integrations → Webhooks → New Webhook
# Name it "Windsage agent". Copy the webhook URL.

WINDSAGE_DISCORD_UPDATES_WEBHOOK=https://discord.com/api/webhooks/ID/TOKEN
# WINDSAGE_DISCORD_USERNAME=Windsage agent

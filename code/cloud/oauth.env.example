# Copy to /data/windsage/oauth.env on Wald (chmod 600). Never commit real secrets.
# After editing: sudo systemctl restart windsage
#
# Full guide: docs/SSO-SETUP.md
#
# Canonical public HTTPS: https://windsage.nimrod.bio
#
# --- Google (ready in app — only needs these two secrets) ---
# Google Cloud Console → OAuth client type "Web application"
# Authorized redirect URI (exact):
#   https://windsage.nimrod.bio/v1/auth/google/callback

WINDSAGE_PUBLIC_URL=https://windsage.nimrod.bio
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Facebook (env gate exists; start/callback code still TODO) ---
# Redirect later: https://windsage.nimrod.bio/v1/auth/facebook/callback
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# --- Apple (env gate exists; Sign in with Apple code still TODO) ---
# Return URL later: https://windsage.nimrod.bio/v1/auth/apple/callback
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=/data/windsage/apple-auth-key.p8

# --- Google Maps (optional — address autocomplete + geocoding) ---
# Without these, Map/Address uses Photon/OSM + Open-Meteo, and pasted Google Maps links still work.
# Enable Geocoding API + Places API (and Maps JavaScript API if using browser map key).
# Restrict browser key by HTTP referrer: https://windsage.nimrod.bio/*
# GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_BROWSER_KEY=

# --- Weather data sources (optional tokens) ---
# NDBC + Open-Meteo need no keys.
# Synoptic free token: https://developers.synopticdata.com/
# SYNOPTIC_TOKEN=
# Tempest personal token: tempest.earth → Settings → Data Authorizations
# TEMPEST_TOKEN=
# Windfinder business API (contact Windfinder):
# WINDFINDER_API_KEY=
# WINDFINDER_API_BASE=https://api.windfinder.com/v2

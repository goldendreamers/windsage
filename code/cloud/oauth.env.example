# Copy to /data/windsage/oauth.env on Wald (chmod 600). Never commit real secrets.
# After editing: sudo systemctl restart windsage
#
# Full guide: docs/ACQUIRE-KEYS.md
# Google SSO: docs/SSO-SETUP.md
#
# Canonical public HTTPS: https://windsage.nimrod.bio
#
# --- Google (ready in app — only needs these two secrets) ---
# Google Cloud Console → OAuth client type "Web application"
# Authorized redirect URI (exact):
#   https://windsage.nimrod.bio/v1/auth/google/callback

WINDSAGE_PUBLIC_URL=https://windsage.nimrod.bio
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Discord (sign-in + Join Discord button) ---
# Discord Developer Portal → Application → OAuth2
# Redirect URI (exact):
#   https://windsage.nimrod.bio/v1/auth/discord/callback
# Invite: never-expire https://discord.gg/… or https://discord.com/invite/…
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_INVITE_URL=

# Club hold bell (Discord incoming webhook). Never commit the URL.
# Same shouldNotify event as Web Push. Does not replace the phone.
# DISCORD_HOLD_WEBHOOK_URL=

# --- Facebook / Apple: not used ---
# --- Weather data sources ---
# NDBC + Open-Meteo need no keys.
# Synoptic token is optional. ICAO METARs (LLBG, KSLC, …) work with no key
# via aviationweather.gov. A token unlocks extra MesoWest mesonets:
# https://developers.synopticdata.com/
# SYNOPTIC_TOKEN=
# Tempest / Windfinder: not used (no account / paid API). Do not set.
# --- Alert email backup (optional; Resend) ---
# If set, Wald also emails a copy when a hold-time alert fires.
# RESEND_API_KEY=
# WINDSAGE_EMAIL_FROM=Windsage <alerts@yourdomain>
# WINDSAGE_ALERT_EMAIL=you@gmail.com


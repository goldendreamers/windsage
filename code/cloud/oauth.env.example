# Copy to /data/windsage/oauth.env on Wald (chmod 600). Never commit real secrets.
# After editing: sudo systemctl daemon-reload && sudo systemctl restart windsage
#
# Canonical public HTTPS (Cloudflare): https://windsage.nimrod.bio
# Authorized redirect URI to register in Google Cloud Console (exact string):
#   https://windsage.nimrod.bio/v1/auth/google/callback

WINDSAGE_PUBLIC_URL=https://windsage.nimrod.bio
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

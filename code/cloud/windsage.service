[Unit]
Description=Windsage cloud wind watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=windsage
Group=windsage
WorkingDirectory=/data/windsage
Environment=NODE_ENV=production
Environment=WINDSAGE_HOST=0.0.0.0
Environment=WINDSAGE_PORT=8787
Environment=WINDSAGE_DATA=/data/windsage/data
Environment=WINDSAGE_PUBLIC_URL=https://windsage.nimrod.bio
# Optional secrets (GOOGLE_*, FACEBOOK_*, APPLE_*, WEB_PUSH_VAPID_*, PUBLIC_URL):
#   /data/windsage/oauth.env  (see oauth.env.example)
# Canonical public HTTPS (Cloudflare Tunnel on nimrod.bio):
#   WINDSAGE_PUBLIC_URL=https://windsage.nimrod.bio
# Google redirect URI (exact):
#   https://windsage.nimrod.bio/v1/auth/google/callback
# Set User=/Group= to the Linux account that owns WorkingDirectory.
EnvironmentFile=-/data/windsage/oauth.env
ExecStart=/usr/bin/node /data/windsage/server.mjs
Restart=always
RestartSec=5
MemoryMax=96M
Nice=10

[Install]
WantedBy=multi-user.target

[Unit]
Description=Windsage cloud wind watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nimrodw
Group=nimrodw
WorkingDirectory=/data/windsage
Environment=NODE_ENV=production
Environment=WINDSAGE_HOST=0.0.0.0
Environment=WINDSAGE_PORT=8787
Environment=WINDSAGE_DATA=/data/windsage/data
Environment=WINDSAGE_PUBLIC_URL=https://windsage.nimrod.bio
# Optional secrets (GOOGLE_*, FACEBOOK_*, APPLE_*, and HTTPS PUBLIC_URL override):
#   /data/windsage/oauth.env  (see oauth.env.example)
# Discord alert DMs (separate bot — not Helper, not website OAuth):
#   /data/windsage/discord-alert.env
EnvironmentFile=-/data/windsage/oauth.env
EnvironmentFile=-/data/windsage/discord-alert.env
ExecStart=/usr/bin/node /data/windsage/server.mjs
Restart=always
RestartSec=5
MemoryMax=96M
Nice=10

[Install]
WantedBy=multi-user.target

# Copy to .env.smtp (gitignored) and fill one path.

# --- Gmail SMTP (App Password) ---
WINDSAGE_SMTP_USER=you@example.com
WINDSAGE_SMTP_PASS=xxxx xxxx xxxx xxxx
WINDSAGE_SMTP_HOST=smtp.gmail.com
WINDSAGE_SMTP_PORT=587
WINDSAGE_SMTP_FROM=you@example.com
WINDSAGE_SMTP_FROM_NAME=Windsage
WINDSAGE_EMAIL_TO=you@example.com

# --- OR Resend ---
# RESEND_API_KEY=re_xxxxxxxx
# WINDSAGE_EMAIL_FROM=Windsage <onboarding@resend.dev>

# --- Discord ops (#windsage-updates) ---
# Incoming webhook for scripts/notify-discord.sh (never commit the URL).
# Discord → #windsage-updates → Edit Channel → Integrations → Webhooks
# WINDSAGE_DISCORD_UPDATES_WEBHOOK=https://discord.com/api/webhooks/ID/TOKEN
# WINDSAGE_DISCORD_USERNAME=Windsage agent
